<mujoco model="so101 pick and place">
  <!-- Lives next to so101_new_calib.xml so the include and meshdir="assets" resolve. -->
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="wood" rgba="0.55 0.42 0.3 1"/>
    <material name="bin" rgba="0.2 0.4 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <!-- Arm base sits on the desk at z=0; floor is 0.75 m below. -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.75" material="grid"/>
    <geom name="table" type="box" size="0.35 0.4 0.375" pos="0.15 0 -0.375" material="wood" friction="1 0.005 0.0001"/>

    <!-- 2.5 cm, 20 g cube. condim 4 adds torsional friction so it doesn't spin out of the jaws. -->
    <body name="cube" pos="0.22 -0.10 0.0125">
      <freejoint name="cube_joint"/>
      <geom name="cube" type="box" size="0.0125 0.0125 0.0125" mass="0.02" rgba="0.9 0.2 0.2 1"
        friction="1.5 0.01 0.0002" condim="4" solref="0.01 1"/>
    </body>

    <!-- Open bin, 9 cm inner, 3 cm tall walls. -->
    <body name="bin" pos="0.22 0.12 0">
      <geom name="bin_floor" type="box" size="0.05 0.05 0.003" pos="0 0 0.003" material="bin"/>
      <geom name="bin_wall_px" type="box" size="0.003 0.05 0.015" pos="0.047 0 0.015" material="bin"/>
      <geom name="bin_wall_nx" type="box" size="0.003 0.05 0.015" pos="-0.047 0 0.015" material="bin"/>
      <geom name="bin_wall_py" type="box" size="0.05 0.003 0.015" pos="0 0.047 0.015" material="bin"/>
      <geom name="bin_wall_ny" type="box" size="0.05 0.003 0.015" pos="0 -0.047 0.015" material="bin"/>
      <site name="bin_zone" type="box" size="0.044 0.044 0.02" pos="0 0 0.02" rgba="0 1 0 0.1"/>
    </body>
  </worldbody>
</mujoco>
